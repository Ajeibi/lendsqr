# Used by `next dev` only: talk to the local API (CORS is enabled there).
# Production builds call the same origin (/api/v1), since the API serves this app.
# Matches PORT in the root .env.example; if your API runs elsewhere, override it
# in web/.env.development.local (git-ignored).
NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
