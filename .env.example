NODE_ENV=development
PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1h

# Lendsqr Adjutor Karma blacklist. Leave the key empty to rely on the local blacklist only.
ADJUTOR_BASE_URL=https://adjutor.lendsqr.com/v2
ADJUTOR_API_KEY=
ADJUTOR_TIMEOUT_MS=3000
# false = refuse onboarding when Karma is unreachable
KARMA_FAIL_OPEN=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Minor units (kobo). 500000000 = ₦5,000,000
MAX_TRANSACTION_AMOUNT=500000000
IDEMPOTENCY_TTL_HOURS=24

# Demo seed (npm run seed). Seeding is skipped if either is empty.
SEED_ADMIN_PASSWORD=AdminPass#2026
SEED_DEMO_PASSWORD=DemoPass#2026
